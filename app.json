{
  "expo": {
    "name": "Asoo",
    "slug": "asoo",
    "owner": "en0o0n",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "asoo",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0a11",
    "ios": {
      "bundleIdentifier": "de.feierabendcode.asoo",
      "supportsTablet": false,
      "appleTeamId": "844JD2257D",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification",
          "audio"
        ],
        "NSMicrophoneUsageDescription": "Damit dich andere in Sprach- und 3D-Räumen und bei Anrufen hören.",
        "NSCameraUsageDescription": "Damit du in Sprachräumen und Anrufen deine Kamera teilen kannst."
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0a11",
          "image": "./assets/images/icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Damit du Bilder in Chats schicken und ein Profilbild wählen kannst.",
          "cameraPermission": "Damit du in Sprachräumen und Anrufen deine Kamera teilen kannst.",
          "microphonePermission": "Damit dich andere in Sprach- und 3D-Räumen und bei Anrufen hören."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7c5cff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "9e157594-194d-45bd-8ab3-2a8bdaaf77a7"
      }
    }
  }
}
