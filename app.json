{
  "expo": {
    "name": "Asoo",
    "slug": "asoo",
    "owner": "en0o0n",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "asoo",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0a11",
    "ios": {
      "bundleIdentifier": "de.feierabendcode.asoo",
      "supportsTablet": false,
      "appleTeamId": "844JD2257D",
      "infoPlist": {
        "CFBundleDisplayName": "ToLobby",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification",
          "audio",
          "voip"
        ],
        "NSMicrophoneUsageDescription": "Damit dich andere in Sprach- und 3D-Räumen und bei Anrufen hören und du Sprachnachrichten aufnehmen kannst.",
        "NSCameraUsageDescription": "Damit du Fotos für dein Profil aufnehmen und in Anrufen deine Kamera teilen kannst.",
        "RTCAppGroupIdentifier": "group.de.feierabendcode.asoo",
        "RTCScreenSharingExtension": "de.feierabendcode.asoo.broadcast"
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.de.feierabendcode.asoo"
        ]
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0a11",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Damit du Bilder in Chats schicken und ein Profilbild wählen kannst.",
          "cameraPermission": "Damit du Fotos für dein Profil aufnehmen und in Anrufen deine Kamera teilen kannst.",
          "microphonePermission": "Damit dich andere in Sprach- und 3D-Räumen und bei Anrufen hören."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7c5cff",
          "sounds": [
            "./assets/sounds/ring_marimba.wav",
            "./assets/sounds/ring_glocken.wav",
            "./assets/sounds/ring_harfe.wav",
            "./assets/sounds/ring_klassik.wav",
            "./assets/sounds/ring_puls.wav"
          ]
        }
      ],
      "@config-plugins/react-native-webrtc",
      "@bacons/apple-targets",
      [
        "expo-audio",
        {
          "microphonePermission": "Damit dich andere in Sprach- und 3D-Räumen und bei Anrufen hören und du Sprachnachrichten aufnehmen kannst."
        }
      ],
      "expo-sharing",
      "expo-iap",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# WebRTC (Anrufe): Klassen werden über JNI angesprochen – nicht entfernen\n-keep class org.webrtc.** { *; }\n-dontwarn org.webrtc.**\n"
          }
        }
      ],
      "./plugins/withAndroidAppName"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "9e157594-194d-45bd-8ab3-2a8bdaaf77a7"
      }
    },
    "locales": {
      "de": "./locales/de.json",
      "en": "./locales/en.json",
      "ar": "./locales/ar.json",
      "es": "./locales/es.json",
      "fr": "./locales/fr.json",
      "it": "./locales/it.json",
      "ku": "./locales/ku.json",
      "nl": "./locales/nl.json",
      "pl": "./locales/pl.json",
      "pt": "./locales/pt.json",
      "ru": "./locales/ru.json",
      "tr": "./locales/tr.json"
    },
    "android": {
      "package": "de.feierabendcode.asoo",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-foreground.png",
        "backgroundImage": "./assets/images/android-background.png",
        "monochromeImage": "./assets/images/android-monochrome.png",
        "backgroundColor": "#171f40"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    }
  }
}
